msgid "Show hotspot password"
msgstr "Mostrar a palavra-passe do ponto de acesso"

msgid "Edit network connections"
msgstr "Editar ligações de rede"

msgid "Querying NetworkManager…"
msgstr "A consultar o NetworkManager…"

msgid "NetworkManager not reachable"
msgstr "NetworkManager inacessível"

msgid "SSID: %s"
msgstr "SSID: %s"

msgid "Password: %s"
msgstr "Palavra-passe: %s"

msgid "Hotspot on"
msgstr "Ponto de acesso ligado"

msgid "Hotspot off"
msgstr "Ponto de acesso desligado"

msgid "Switching hotspot…"
msgstr "A alternar o ponto de acesso…"

msgid "Click to switch off"
msgstr "Clique para desligar"

msgid "Click to switch on"
msgstr "Clique para ligar"

msgid "Unknown error"
msgstr "Erro desconhecido"

msgid "Connection not found"
msgstr "Ligação não encontrada"

msgid "Hotspot connection (NetworkManager)"
msgstr "Ligação do ponto de acesso (NetworkManager)"

msgid "Connection name"
msgstr "Nome da ligação"

msgid "Name of the NetworkManager connection that is switched on and off."
msgstr "Nome da ligação do NetworkManager que é ligada e desligada."

msgid "Only used when creating the connection for the first time (if it does not exist yet)"
msgstr "Usado apenas na primeira criação da ligação (se ainda não existir)"

msgid "Leave empty for the NetworkManager default (hostname)."
msgstr "Deixe em branco para o valor predefinido do NetworkManager (nome do anfitrião)."

msgid "Password (at least 8 characters)"
msgstr "Palavra-passe (mínimo de 8 caracteres)"

msgid "Leave empty and NetworkManager will generate a random password."
msgstr "Deixe em branco e o NetworkManager gera uma palavra-passe aleatória."

msgid "Switches the wifi hotspot on and off with a click and shows its state."
msgstr "Liga e desliga o ponto de acesso Wi-Fi com um clique e mostra o seu estado."
